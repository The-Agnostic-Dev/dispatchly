# Copy to .env (or export these) to override the defaults.
PORT=5115
DISPATCHLY_DB=dispatchly.sqlite3
# Wipe and reload the demo data on start (the Docker image always does this).
DISPATCHLY_RESEED=0
# How long the development SMS stub waits before "sending" a job text.
DISPATCHLY_SMS_LATENCY_MS=300
RUST_LOG=info,dispatchly=info
